#!/bin/bash

# helios:summary=Send the low battery warning notification and run battery-low hooks.
# helios:args=<percentage>
# helios:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: helios-battery-low <percentage>" >&2
  exit 1
fi

level=$1

helios-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
helios-hook battery-low "$level"
