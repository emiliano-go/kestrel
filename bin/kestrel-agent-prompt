#!/bin/bash

# kestrel:summary=Launch the default coding agent with a prompt
# kestrel:args=[--inline] <prompt...>
# kestrel:examples=kestrel agent prompt "Review this project"

# Prompts live here rather than on `kestrel agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: kestrel agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec kestrel-agent "${inline[@]}" --prompt "$*"
