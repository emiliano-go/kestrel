#!/bin/bash

# helios:summary=Cycle to the next media source and transfer playback when the current source is playing
# helios:args=[next|previous]
# helios:examples=helios audio source switch | helios-audio-source-switch previous

direction="${1:-next}"

case "$direction" in
  next)
    helios-shell media sourceSwitch
    ;;
  previous)
    helios-shell media sourceSwitchPrevious
    ;;
  *)
    echo "Usage: helios-audio-source-switch [next|previous]" >&2
    exit 1
    ;;
esac
