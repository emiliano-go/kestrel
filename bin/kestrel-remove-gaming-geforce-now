#!/bin/bash

# kestrel:summary=Remove the GeForce NOW Flatpak app and its data.
# kestrel:group=remove
# kestrel:name=gaming geforce-now

set -e

if kestrel-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
