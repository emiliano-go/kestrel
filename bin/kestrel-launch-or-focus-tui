#!/bin/bash

# kestrel:summary=Launch a TUI or focus an existing terminal window for it
# kestrel:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.kestrel.$(basename "$1")"
fi

LAUNCH_COMMAND="kestrel-launch-tui $@"

exec kestrel-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
