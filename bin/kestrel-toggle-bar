#!/bin/bash

# kestrel:summary=Toggle bar visibility without killing the Kestrel shell
# kestrel:args=[toggle|on|off]
# kestrel:examples=kestrel toggle bar | kestrel toggle bar off | kestrel toggle bar on

kestrel-toggle bar-off "${1:-toggle}"

# The shell's watch on the toggles directory can miss flag changes that land in
# quick succession, stranding the bar off screen until the shell restarts.
# Nudge the bar to re-read the flag; quiet best-effort so the toggle still
# works when the shell is not up.
kestrel-shell -q kestrel.bar syncHidden
