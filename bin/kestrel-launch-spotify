#!/bin/bash

# kestrel:summary=Launch Spotify or start its installer when missing.

set -e

WINDOW_ID=$(mmsg get all-clients 2>/dev/null | jq -r '.clients[]|select(((.appid // "")|test("\\bspotify\\b";"i")) or ((.title // "")|test("\\bspotify\\b";"i")))|.id' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  mmsg dispatch focusid "client,$WINDOW_ID" >/dev/null 2>&1
elif [[ -x /usr/bin/spotify ]]; then
  exec setsid uwsm-app -- /usr/bin/spotify
else
  exec kestrel-launch-floating-terminal-with-presentation kestrel-install-service-spotify
fi
