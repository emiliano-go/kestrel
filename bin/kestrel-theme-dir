#!/bin/bash

# kestrel:summary=Print the directory holding a theme, preferring a user-installed copy
# kestrel:args=<theme-name>
# kestrel:examples=kestrel theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: kestrel-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/kestrel/themes/$theme ]]; then
  echo "$HOME/.config/kestrel/themes/$theme"
else
  echo "$KESTREL_PATH/themes/$theme"
fi
