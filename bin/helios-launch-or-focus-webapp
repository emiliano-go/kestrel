#!/bin/bash

# helios:summary=Launch or focus on a given web app identified by the window-pattern.
# helios:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: helios-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="helios-launch-webapp $@"

exec helios-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
