#!/bin/bash

# kestrel:summary=Show which theme is styling the Plymouth boot screen
# kestrel:examples=kestrel plymouth current

# kestrel-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/kestrel/logo.png

if cmp -s "$KESTREL_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

kestrel-plymouth-list | while read -r name; do
  if cmp -s "$(kestrel-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
