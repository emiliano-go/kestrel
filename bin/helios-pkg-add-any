#!/bin/bash

# helios:summary=Install packages from the Arch repositories, falling back to the AUR
# helios:args=<packages...>
# helios:examples=helios pkg add-any localsend jq
# helios:requires-sudo=true

# HeliOS no longer ships its own package repository, so a package that used to
# come from the [helios] repo is now either in the Arch repositories or in the
# AUR. Route each package accordingly.
rc=0
for pkg in "$@"; do
  helios-pkg-present "$pkg" && continue
  if pacman -Si -- "$pkg" &>/dev/null; then
    helios-pkg-add "$pkg" || rc=1
  else
    helios-pkg-aur-add "$pkg" || rc=1
  fi
done
exit $rc
