#!/bin/bash

# helios:summary=Toggle animations, transparency and other effects that are slow without a GPU
# helios:args=[toggle|on|off]
# helios:examples=helios toggle animations | helios toggle animations off | helios toggle animations on

# The flag records animations being off, so on and off swap on the way through.
case ${1:-toggle} in
toggle) helios-hyprland-toggle no-animations toggle ;;
on) helios-hyprland-toggle no-animations off ;;
off) helios-hyprland-toggle no-animations on ;;
*)
  echo "Usage: helios-toggle-animations [toggle|on|off]" >&2
  exit 1
  ;;
esac

if helios-hyprland-toggle-enabled no-animations; then
  helios-notification-send -g 󰕟 "Animations disabled"
else
  helios-notification-send -g 󰕟 "Animations enabled"
fi
