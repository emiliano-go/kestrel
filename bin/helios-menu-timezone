#!/bin/bash

# helios:summary=Select and set the system timezone
# helios:group=menu
# helios:name=timezone

set -e

timezone=$(timedatectl list-timezones | helios-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
helios-shell -q helios.clock refresh
helios-notification-send "Timezone is now set to $timezone"
