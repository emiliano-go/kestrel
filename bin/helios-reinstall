#!/bin/bash

# helios:summary=Reinstall HeliOS packages and reset default configs
# helios:requires-sudo=true

set -e

echo -e "This will reinstall all default HeliOS packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  helios-reinstall-pkgs
  helios-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && helios-system-reboot
fi
