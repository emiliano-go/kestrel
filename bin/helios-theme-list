#!/bin/bash

# helios:summary=List available themes
# helios:examples=helios theme list | helios theme set "Tokyo Night"

{
  find ~/.config/helios/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$HELIOS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
