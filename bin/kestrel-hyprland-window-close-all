#!/bin/bash

# kestrel:summary=Close all open windows

# Close every client, then return to the first tag on the focused monitor.
mmsg get all-clients 2>/dev/null | jq -r '.clients[].id' | while read -r id; do
  [[ -n $id ]] || continue
  mmsg dispatch killclient "client,$id" >/dev/null 2>&1 || true
done

mmsg dispatch view,1 >/dev/null 2>&1 || true
