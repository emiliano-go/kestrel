#!/bin/bash

# kestrel:summary=Select and set the system timezone
# kestrel:group=menu
# kestrel:name=timezone

set -e

timezone=$(timedatectl list-timezones | kestrel-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
kestrel-shell -q kestrel.clock refresh
kestrel-notification-send "Timezone is now set to $timezone"
