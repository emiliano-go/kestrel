#!/bin/bash

# helios:summary=Disable a shell plugin
# helios:group=plugin
# helios:args=<id>

set -euo pipefail

fail() {
  echo "helios-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: helios plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(helios-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: helios-shell shell rescanPlugins"

echo "Disabled $id"
