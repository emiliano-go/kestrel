#!/bin/bash

# kestrel:summary=Apply Kestrel system setup in the installed target
# kestrel:group=apply
# kestrel:requires-sudo=true
# kestrel:examples=kestrel apply system --install-user dhh --first-install
# kestrel:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: kestrel apply system --install-user USER [--first-install|--upgrade]
       kestrel apply system --defer-provisioning --first-install

Runs root-owned Kestrel system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
kestrel-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/kestrel/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${KESTREL_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: kestrel-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export KESTREL_INSTALL_USER="$install_user"
export KESTREL_FIRST_INSTALL="$first_install"
export KESTREL_UPGRADE="$upgrade"
export KESTREL_PATH="${KESTREL_PATH:-/usr/share/kestrel}"
export KESTREL_INSTALL="${KESTREL_INSTALL:-$KESTREL_PATH/install}"
export KESTREL_INSTALL_LOG_FILE="${KESTREL_INSTALL_LOG_FILE:-/var/log/kestrel-install.log}"
export PATH="$KESTREL_PATH/bin:$PATH"

source "$KESTREL_INSTALL/helpers/logging.sh"
start_install_log

# Deploy the payload onto its fixed system paths before any config script reads
# them. On a package-backed install these are already in place; on the ISO's
# file deployment this is what puts them there.
kestrel-apply-system-files

source "$KESTREL_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  kestrel-apply-hardware --defer-provisioning
else
  kestrel-apply-hardware --install-user "$install_user"
fi

source "$KESTREL_INSTALL/login/all.sh"
source "$KESTREL_INSTALL/post-install/all.sh"

stop_install_log
