#!/bin/bash

# helios:summary=Finalize HeliOS user setup (runtime tweaks /etc/skel can't do)
# helios:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: helios finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and helios-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/helios/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run helios-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/helios"
mkdir -p "$state_dir"

if helios-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete."
  exit 0
fi

export HELIOS_PATH="${HELIOS_PATH:-/usr/share/helios}"
export HELIOS_INSTALL="${HELIOS_INSTALL:-$HELIOS_PATH/install}"
export HELIOS_SETUP_CONTEXT="${HELIOS_SETUP_CONTEXT:-runtime}"
export PATH="$HELIOS_PATH/bin:$PATH"

if (( first_install )) && [[ $HELIOS_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; helios-provision-owner runs first-install
  # finalization too but with HELIOS_SETUP_CONTEXT=provision-owner already set.
  export HELIOS_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${HELIOS_INSTALL_LOG_FILE:-} && -f $HELIOS_INSTALL/helpers/logging.sh ]]; then
  source "$HELIOS_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

# Dev-aware skill symlinks. Cannot live in /etc/skel because HELIOS_PATH may
# point at a dev checkout (helios dev link) where the target differs.
# Loops every skill directory, so shipping a new one needs no edit here.
mkdir -p ~/.agents/skills ~/.claude/skills ~/.codex/skills ~/.pi/agent/skills ~/.gemini/config/skills ~/.hermes/skills
for skill in "$HELIOS_PATH"/default/agents/skills/*/; do
  skill=${skill%/}
  name=${skill##*/}
  ln -sfn "$skill" ~/.agents/skills/"$name"
  ln -sfn "$skill" ~/.claude/skills/"$name"
  ln -sfn "$skill" ~/.codex/skills/"$name"
  ln -sfn "$skill" ~/.pi/agent/skills/"$name"
  ln -sfn "$skill" ~/.gemini/config/skills/"$name"
  ln -sfn "$skill" ~/.hermes/skills/"$name"
  if [[ -d ~/.hermes/profiles ]]; then
    for profile in ~/.hermes/profiles/*/; do
      [[ -d $profile ]] || continue
      mkdir -p "$profile/skills"
      ln -sfn "$skill" "$profile/skills/$name"
    done
  fi
done

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$HELIOS_INSTALL/user/all.sh"

helios-refresh-applications
env -u BROWSER xdg-settings set default-web-browser chromium.desktop
xdg-mime default HEY.desktop x-scheme-handler/mailto

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$HELIOS_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

helios-done mark finalize-user
echo "User finalization complete."
