#!/bin/bash

# kestrel:summary=Print the active Kestrel package channel

set -euo pipefail

# Dev is a linked source checkout: KESTREL_PATH points somewhere other than
# the package-backed install at /usr/share/kestrel. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $KESTREL_PATH != "/usr/share/kestrel" ]]; then
  echo dev
  exit 0
fi

# kestrel-dev / kestrel-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. kestrel / kestrel-settings come
# from either the stable or rc mirror, distinguished by kestrel-version-channel
# (which reports the mirror as its first token).
if pacman -Q kestrel-dev kestrel-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q kestrel kestrel-settings >/dev/null 2>&1; then
  channel=$(kestrel-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
