#!/bin/bash -p

# kestrel:summary=Set the Kestrel package channel.
# kestrel:args=<stable|rc|edge|dev>
# kestrel:requires-sudo=true

if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup for channel switching." >&2
  exit 126
fi
security_entrypoint=$(/usr/bin/readlink -e -- "${BASH_SOURCE[0]}") || exit 126
source "${security_entrypoint%/*}/kestrel-security-functions" || exit 126
kestrel_security_require_privileged_bash_startup || exit 126
set -euo pipefail
kestrel_security_sanitize_bash_environment "$0" "$@"
kestrel_security_require_source_root "$0"
user_path=$PATH
# Traps first, so a signal or failure during the entry revocation still
# exits through the cleanup path.
kestrel_security_install_sudo_cleanup_traps
kestrel_security_revoke_sudo_timestamp || exit 1
kestrel_security_enable_no_update_sudo

usage() { echo "Usage: kestrel-channel-set [stable|rc|edge|dev]"; }
fail() { echo "Error: $*" >&2; exit 1; }

confirm_dev() {
  cat <<'WARNING'

The dev channel links Kestrel directly to a checkout of the source in ~/kestrel.
It's exclusively intended for developers working on Kestrel itself.

WARNING

  gum confirm --default=false "Switch to dev channel?"
}

validate_dev_checkout() {
  local checkout="$1"

  if [[ -e $checkout && ! -d $checkout/.git ]]; then
    fail "$checkout already exists and is not a git checkout."
  fi

  if [[ -d $checkout/.git && ( ! -d $checkout/bin || ! -d $checkout/default || ! -d $checkout/shell ) ]]; then
    fail "$checkout is a git checkout, but it does not look like Kestrel."
  fi
}

link_dev_checkout() {
  local checkout="$1" required
  [[ -d $checkout/.git ]] || git clone https://github.com/omacom/omarchy.git "$checkout"

  # Check the destination before changing /etc/kestrel.conf or sudo's path.
  # An existing checkout is not pulled automatically and may predate this policy.
  for required in bin/kestrel-security-functions bin/kestrel-update bin/kestrel-refresh-pacman default/kestrel/sudo-no-update/sudo; do
    if [[ ! -f $checkout/$required || ! -r $checkout/$required ||
      ( $required != "bin/kestrel-security-functions" && ! -x $checkout/$required ) ]]; then
      fail "Update the checkout before switching to dev; missing required update support in $required."
    fi
  done

  kestrel-dev-link "$checkout" --no-reboot
}

# A packaged destination cannot be inspected before its package is installed,
# and a package transaction can replace the running tree with a release that
# predates the command-scoped wrapper. After that, a bare sudo would resolve to
# /usr/bin/sudo and publish a timestamp, and the destination's own updater
# authenticates the same way. Neither may run from a flow that has just run
# user hooks: stop at a consistent point and say how to finish from a fresh
# session.
stop_for_older_destination() {
  cat >&2 <<EOF
The destination predates command-scoped sudo, so this switch stops before its update.
Packages are switched. Run 'kestrel update' from a new terminal to finish, then reboot if prompted.
EOF
  exit 3
}

wrapper_present() {
  [[ -f $KESTREL_PATH/default/kestrel/sudo-no-update/sudo && -x $KESTREL_PATH/default/kestrel/sudo-no-update/sudo ]]
}

(( $# > 0 )) || { usage; exit 1; }

dev_checkout=""
channel="$1"
leaving_dev=0

case "$channel" in
  stable)
    pacman_channel=stable
    packages=(kestrel kestrel-settings)
    ;;
  rc)
    pacman_channel=rc
    packages=(kestrel kestrel-settings)
    ;;
  edge)
    pacman_channel=edge
    packages=(kestrel-dev kestrel-settings-dev)
    ;;
  dev)
    confirm_dev || { echo "Cancelled."; exit 0; }
    dev_checkout="$HOME/kestrel"
    validate_dev_checkout "$dev_checkout"
    pacman_channel=edge
    packages=(kestrel-dev kestrel-settings-dev)
    ;;
  *)
    echo "Unknown channel: $channel" >&2
    usage >&2
    exit 1
    ;;
esac

# A failure past this point leaves the channel switch half-applied, so say how
# to pick it back up rather than dying silently under set -e.
trap 'echo -e "\nThe channel switch did not complete. Review the error above, then rerun: kestrel-channel-set '"$channel"'" >&2' ERR

if [[ -z $dev_checkout && $KESTREL_PATH != "/usr/share/kestrel" ]]; then
  leaving_dev=1
fi

if [[ -n $dev_checkout ]]; then
  link_dev_checkout "$dev_checkout"
  export KESTREL_PATH="$dev_checkout"
  kestrel_security_enable_no_update_sudo
  kestrel-state set reboot-required
fi

KESTREL_UPDATE_USER_PATH="$user_path" kestrel-refresh-pacman "$pacman_channel"
# Each transaction can have replaced this tree; check before the next sudo.
wrapper_present || stop_for_older_destination
# --ask 4 accepts kestrel <-> kestrel-dev replacement prompts without file overwrites.
kestrel-update-pacman -S --needed --noconfirm --ask 4 "${packages[@]}"
wrapper_present || stop_for_older_destination

if [[ -z $dev_checkout ]]; then
  kestrel-dev-unlink --no-reboot
  export KESTREL_PATH=/usr/share/kestrel

  if (( leaving_dev )); then
    kestrel-state set reboot-required
  fi
  kestrel_security_enable_no_update_sudo 2>/dev/null || stop_for_older_destination
fi

KESTREL_UPDATE_USER_PATH="$user_path" "$KESTREL_PATH/bin/kestrel-update" -y
