#!/bin/bash

# kestrel:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.local/state/kestrel/current/theme.name")
THEME_USER_BACKGROUNDS="$HOME/.config/kestrel/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
