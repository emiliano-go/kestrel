#!/bin/bash

# kestrel:summary=Apply Kestrel hardware-specific packages and system configuration
# kestrel:group=apply
# kestrel:requires-sudo=true
# kestrel:examples=kestrel apply hardware --install-user dhh
# kestrel:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: kestrel apply hardware --install-user USER
       kestrel apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by kestrel-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/kestrel/provisioning/groups.
USAGE
}

install_user="${KESTREL_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: kestrel-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export KESTREL_INSTALL_USER="$install_user"
export KESTREL_PATH="${KESTREL_PATH:-/usr/share/kestrel}"
export KESTREL_INSTALL="${KESTREL_INSTALL:-$KESTREL_PATH/install}"
export KESTREL_INSTALL_LOG_FILE="${KESTREL_INSTALL_LOG_FILE:-/var/log/kestrel-install.log}"
export PATH="$KESTREL_PATH/bin:$PATH"

source "$KESTREL_INSTALL/helpers/logging.sh"
source "$KESTREL_INSTALL/hardware/all.sh"
