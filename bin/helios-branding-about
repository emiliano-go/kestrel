#!/bin/bash

# helios:summary=Edit, set, or reset About branding
# helios:group=branding
# helios:name=about
# helios:args=<image|text|reset>
# helios:examples=helios branding about image | helios branding about text | helios branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(helios-file-select --title "Pick PNG or SVG for About" --extensions "png svg")
  if helios-transcode-ascii "$image" ~/.config/helios/branding/about.txt --width 54 --height 26; then
    helios-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  helios-launch-editor ~/.config/helios/branding/about.txt >/dev/null 2>&1 && helios-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$HELIOS_PATH/icon.txt" ~/.config/helios/branding/about.txt && helios-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: helios-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
