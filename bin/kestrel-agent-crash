#!/bin/bash

# kestrel:summary=Diagnose a crashed process with the default coding agent
# kestrel:args=<pid> [comm] [exe] [signal]
# kestrel:examples=kestrel agent crash 1516893

# Clicked from a "Process crashed:" notification, or run by hand against any PID
# in `coredumpctl list`. This gathers the facts about the crash and hands them to
# whichever agent is the default.

set -euo pipefail

pid=${1:?usage: kestrel-agent-crash <pid> [comm] [exe] [signal]}

if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Not a PID: $pid" >&2
  echo "Usage: kestrel agent crash <pid>   (see: coredumpctl list)" >&2
  exit 1
fi

comm=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

# Looked up live so a hand-run PID still gets a timestamp. A rotated-away core
# only costs the timestamp, so failure is tolerated.
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

prompt=$(
  cat <<PROMPT
A process crashed on this Kestrel machine and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Investigate with coredumpctl, the core dump, the binary's symbols, and the
journal for the unit. Establish the facts, explain the cause, and tell me whether
the crash is worth reporting upstream.
PROMPT
)

exec kestrel-agent --prompt "$prompt"
