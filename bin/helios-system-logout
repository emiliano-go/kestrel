#!/bin/bash

# helios:summary=Log out after closing application windows
# helios:examples=helios logout | helios system logout
# helios:aliases=helios logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

helios-osd -i logout -m "Logging out" -d 5000

# Now close all windows
helios-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
