#!/bin/bash

# kestrel:summary=Save or restore the focused window width
# kestrel:args=<save|restore>
# kestrel:examples=kestrel hyprland window width save | kestrel-hyprland-window-width restore

set -euo pipefail

STATE_DIR="$HOME/.local/state/kestrel/windows"

usage() {
  echo "Usage: kestrel-hyprland-window-width save|restore" >&2
  exit 1
}

active=$(mmsg get focusing-client 2>/dev/null) || exit 1
id=$(jq -er '.id' <<<"$active") || exit 1
width=$(jq -er '.width' <<<"$active") || exit 1
height=$(jq -er '.height' <<<"$active") || exit 1
key=$(jq -r '.appid // .title // empty' <<<"$active")
monitor=$(jq -r '.monitor // empty' <<<"$active")
tag=$(jq -r '.tags[0] // 0' <<<"$active")
[[ -n $key ]] || exit 1

safe_key=${key//\//_}
state_file="$STATE_DIR/${monitor}-tag${tag}-${safe_key}.width"

action=${1:-}
[[ $action == "save" || $action == "restore" ]] || usage

case "$action" in
save)
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$width" >"$state_file"
  kestrel-notification-send -g 󰤨 "Saved width for $key" "Restore with Super + Home."
  echo "Saved width $width for $key"
  ;;
restore)
  if [[ ! -f $state_file ]]; then
    kestrel-notification-send -g 󰤨 "No saved width for $key" "Save one with Super + Alt + Home."
    exit 1
  fi
  saved=$(<"$state_file")
  [[ $saved =~ ^[0-9]+$ ]] || exit 1
  mmsg dispatch "resizewin,$saved,$height" "client,$id" >/dev/null
  ;;
esac
