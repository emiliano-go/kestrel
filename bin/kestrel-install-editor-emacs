#!/bin/bash

# kestrel:summary=Install Emacs with Kestrel theme and font integration via the kestrel-emacs AUR package

echo "Installing Emacs..."
kestrel-pkg-aur-add kestrel-emacs && kestrel-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid uwsm-app -- gtk-launch emacsclient >/dev/null 2>&1 &
