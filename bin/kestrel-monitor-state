#!/bin/bash

# kestrel:summary=Print monitor panel state for the shell
# kestrel:group=monitor

monitors_json=$(mmsg get all-monitors 2>/dev/null)
focused_monitor=$(jq -r '[.monitors[] | select(.active == true)][0].name // ""' <<<"$monitors_json")

{ kestrel-brightness-display --monitor "$focused_monitor" 2>/dev/null; echo; } | head -n 1

jq -r '
  def internal: test("^(eDP|LVDS|DSI)-");
  ([.monitors[] | select(.name | internal)][0].name // ""),
  ([.monitors[] | select((.name | internal) | not)][0].name // ""),
  ([.monitors[] | select(.name | internal)][0].name // ""),
  ("")
' <<<"$monitors_json"

printf '%s\n' "$focused_monitor"
kestrel-hyprland-monitor-scaling 2>/dev/null || echo

jq -c '[.monitors[] | {name, enabled:true, focused:(.active == true), width, height}]' <<<"$monitors_json"
