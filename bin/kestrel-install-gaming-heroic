#!/bin/bash

# kestrel:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# kestrel:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
kestrel-pkg-add heroic-games-launcher-bin
kestrel-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
