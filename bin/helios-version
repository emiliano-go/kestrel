#!/bin/bash

# helios:summary=Print the installed HeliOS version

helios_path=${HELIOS_PATH:-/usr/share/helios}
helios_path=${helios_path%/}

if [[ $helios_path != "/usr/share/helios" ]]; then
  hash=$(git -C "$helios_path" rev-parse --short HEAD 2>/dev/null || true)

  if [[ -n $hash ]]; then
    echo "dev ($hash)"
  else
    echo "dev"
  fi

  exit 0
fi

# The edge channel installs helios-dev instead of helios, so check both.
for package in helios-dev helios; do
  version=$(pacman -Q "$package" 2>/dev/null | awk '{ print $2 }')
  [[ -n $version ]] && break
done

[[ -n $version ]] || exit 1

echo "$version"
