#!/bin/bash

# kestrel:summary=Disable a shell plugin
# kestrel:group=plugin
# kestrel:args=<id>

set -euo pipefail

fail() {
  echo "kestrel-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: kestrel plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(kestrel-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: kestrel-shell shell rescanPlugins"

echo "Disabled $id"
