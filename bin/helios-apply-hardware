#!/bin/bash

# helios:summary=Apply HeliOS hardware-specific packages and system configuration
# helios:group=apply
# helios:requires-sudo=true
# helios:examples=helios apply hardware --install-user dhh
# helios:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: helios apply hardware --install-user USER
       helios apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by helios-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/helios/provisioning/groups.
USAGE
}

install_user="${HELIOS_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: helios-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export HELIOS_INSTALL_USER="$install_user"
export HELIOS_PATH="${HELIOS_PATH:-/usr/share/helios}"
export HELIOS_INSTALL="${HELIOS_INSTALL:-$HELIOS_PATH/install}"
export HELIOS_INSTALL_LOG_FILE="${HELIOS_INSTALL_LOG_FILE:-/var/log/helios-install.log}"
export PATH="$HELIOS_PATH/bin:$PATH"

source "$HELIOS_INSTALL/helpers/logging.sh"
source "$HELIOS_INSTALL/hardware/all.sh"
