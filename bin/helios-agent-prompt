#!/bin/bash

# helios:summary=Launch the default coding agent with a prompt
# helios:args=[--inline] <prompt...>
# helios:examples=helios agent prompt "Review this project"

# Prompts live here rather than on `helios agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: helios agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec helios-agent "${inline[@]}" --prompt "$*"
