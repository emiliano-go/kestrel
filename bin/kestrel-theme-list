#!/bin/bash

# kestrel:summary=List available themes
# kestrel:examples=kestrel theme list | kestrel theme set "Tokyo Night"

{
  find ~/.config/kestrel/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$KESTREL_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
