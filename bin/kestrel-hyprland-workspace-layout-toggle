#!/bin/bash

# kestrel:summary=Toggle the layout on the focused monitor between tile and scroller

monitor=$(mmsg get all-monitors 2>/dev/null | jq -r '.monitors[] | select(.active == true)')
symbol=$(jq -r '.layout_symbol // empty' <<<"$monitor")

case "$symbol" in
*scroller*) new_layout=tile ;;
*) new_layout=scroller ;;
esac

mmsg dispatch "setlayout,$new_layout" >/dev/null 2>&1 || exit 1
kestrel-notification-send -g 󱂬 "Layout set to $new_layout"
