#!/bin/bash

# helios:summary=Launch a TUI or focus an existing terminal window for it
# helios:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.helios.$(basename "$1")"
fi

LAUNCH_COMMAND="helios-launch-tui $@"

exec helios-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
