#!/bin/bash

# helios:summary=Apply HeliOS system setup in the installed target
# helios:group=apply
# helios:requires-sudo=true
# helios:examples=helios apply system --install-user dhh --first-install
# helios:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: helios apply system --install-user USER [--first-install|--upgrade]
       helios apply system --defer-provisioning --first-install

Runs root-owned HeliOS system setup. The ISO calls this in the target chroot
after packages are installed and the target user exists. It also calls
helios-apply-hardware, so hardware setup cannot be accidentally skipped.

--defer-provisioning runs without an install user: deferred-provisioning installs create the user at
first boot, so scripts that grant group memberships record them in
/var/lib/helios/provisioning/groups instead of calling usermod.
USAGE
}

install_user="${HELIOS_INSTALL_USER:-}"
first_install=0
upgrade=0
defer_provisioning=0

while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    --first-install)
      first_install=1
      shift
      ;;
    --upgrade)
      upgrade=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: helios-apply-system must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export HELIOS_INSTALL_USER="$install_user"
export HELIOS_FIRST_INSTALL="$first_install"
export HELIOS_UPGRADE="$upgrade"
export HELIOS_PATH="${HELIOS_PATH:-/usr/share/helios}"
export HELIOS_INSTALL="${HELIOS_INSTALL:-$HELIOS_PATH/install}"
export HELIOS_INSTALL_LOG_FILE="${HELIOS_INSTALL_LOG_FILE:-/var/log/helios-install.log}"
export PATH="$HELIOS_PATH/bin:$PATH"

source "$HELIOS_INSTALL/helpers/logging.sh"
start_install_log

source "$HELIOS_INSTALL/config/all.sh"

if (( defer_provisioning )); then
  helios-apply-hardware --defer-provisioning
else
  helios-apply-hardware --install-user "$install_user"
fi

source "$HELIOS_INSTALL/login/all.sh"
source "$HELIOS_INSTALL/post-install/all.sh"

stop_install_log
