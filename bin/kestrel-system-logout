#!/bin/bash

# kestrel:summary=Log out after closing application windows
# kestrel:examples=kestrel logout | kestrel system logout
# kestrel:aliases=kestrel logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

kestrel-osd -i logout -m "Logging out" -d 5000

# Now close all windows
kestrel-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
