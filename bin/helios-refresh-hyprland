#!/bin/bash

# helios:summary=Overwrite all the user Hyprland Lua configs in ~/.config/hypr with the HeliOS defaults.

helios-refresh-config hypr/.luarc.json
helios-refresh-config hypr/autostart.lua
helios-refresh-config hypr/bindings.lua
helios-refresh-config hypr/input.lua
helios-refresh-config hypr/looknfeel.lua
helios-refresh-config hypr/hyprland.lua
helios-refresh-config hypr/monitors.lua

mkdir -p ~/.local/state/helios/toggles/hypr
cp "$HELIOS_PATH/default/hypr/toggles/flags.lua" ~/.local/state/helios/toggles/hypr/
