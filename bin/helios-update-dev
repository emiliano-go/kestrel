#!/bin/bash

# helios:summary=Update the active HeliOS dev checkout

set -euo pipefail

[[ $HELIOS_PATH != "/usr/share/helios" ]] || exit 0

if ! git -C "$HELIOS_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: HELIOS_PATH is not a git checkout: $HELIOS_PATH" >&2
  exit 1
fi

upstream=$(git -C "$HELIOS_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip HeliOS dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate HeliOS dev checkout\e[0m"
git -C "$HELIOS_PATH" pull --ff-only
