#!/bin/bash

# kestrel:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# kestrel:args=[toggle|on|off]
# kestrel:examples=kestrel toggle fullscreen desktop | kestrel toggle fullscreen desktop off | kestrel toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if kestrel-toggle-enabled bar-off && kestrel-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: kestrel-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

kestrel-toggle-bar "$ACTION"
kestrel-hyprland-toggle window-no-gaps "$ACTION"
