#!/bin/bash

# helios:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# helios:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
helios-pkg-add heroic-games-launcher-bin
helios-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
