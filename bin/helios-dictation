#!/bin/bash

# helios:summary=Record dictation with the configured backend
# helios:args=<start|stop|toggle>
# helios:examples=helios dictation start | helios dictation toggle

if (($# != 1)) || [[ $1 != "start" && $1 != "stop" && $1 != "toggle" ]]; then
  echo "Usage: helios dictation <start|stop|toggle>" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/helios/defaults/dictation"
mkdir -p "${config%/*}"
exec 9> "$config.lock"
if ! flock -w 5 9; then
  echo "Dictation is busy; try again." >&2
  exit 1
fi

backend=$(helios-default-dictation) || exit 1
adapter="helios-dictation-$backend"
if helios-cmd-missing "$adapter"; then
  echo "The selected dictation backend ($backend) is not installed." >&2
  exit 1
fi
"$adapter" "$1" 9>&-
