#!/bin/bash

# kestrel:summary=Finalize Kestrel user setup (runtime tweaks /etc/skel can't do)
# kestrel:group=finalize
# kestrel:name=user
# kestrel:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: kestrel finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser, and install/user/all.sh.

For shipped configs see /etc/skel (new users); existing users resync by
replaying /etc/skel over $HOME.

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/kestrel/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run kestrel-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/kestrel"
mkdir -p "$state_dir"

if kestrel-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete."
  exit 0
fi

export KESTREL_PATH="${KESTREL_PATH:-/usr/share/kestrel}"
export KESTREL_INSTALL="${KESTREL_INSTALL:-$KESTREL_PATH/install}"
export KESTREL_SETUP_CONTEXT="${KESTREL_SETUP_CONTEXT:-runtime}"
export PATH="$KESTREL_PATH/bin:$PATH"

if (( first_install )) && [[ $KESTREL_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; kestrel-provision-owner runs first-install
  # finalization too but with KESTREL_SETUP_CONTEXT=provision-owner already set.
  export KESTREL_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${KESTREL_INSTALL_LOG_FILE:-} && -f $KESTREL_INSTALL/helpers/logging.sh ]]; then
  source "$KESTREL_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$KESTREL_INSTALL/user/all.sh"

kestrel-refresh-applications
env -u BROWSER xdg-settings set default-web-browser chromium.desktop

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$KESTREL_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

kestrel-done mark finalize-user
echo "User finalization complete."
