#!/bin/bash

# helios:summary=Launch a terminal in the active terminal's current directory
# helios:args=[--pid=<terminal-pid>] [command...]

pid=""
if [[ ${1:-} == --pid=* ]]; then
  pid=${1#--pid=}
  shift
fi

exec setsid uwsm-app -- xdg-terminal-exec --dir="$(helios-cmd-terminal-cwd "$pid")" "$@"
