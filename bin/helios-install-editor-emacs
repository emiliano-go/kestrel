#!/bin/bash

# helios:summary=Install Emacs with HeliOS theme and font integration via the helios-emacs AUR package

echo "Installing Emacs..."
helios-pkg-aur-add helios-emacs && helios-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid uwsm-app -- gtk-launch emacsclient >/dev/null 2>&1 &
