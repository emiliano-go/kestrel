#!/bin/bash

# kestrel:summary=Refresh the SDDM theme from default
# kestrel:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves an untrusted source or
# follows a destination symlink while restoring the packaged SDDM theme.
exec "$KESTREL_PATH/bin/kestrel-plymouth-set" --refresh-sddm-default
