#!/bin/bash

# helios:summary=Rename a Claude, Codex, or Grok subscription account
# helios:args=[claude|codex|grok] <account> <name>
# helios:examples=helios agent account rename primary Hey | helios agent account rename codex side Side project

set -uo pipefail

# The provider can be left out when it's your default agent:
# `helios agent account rename primary Hey`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]]; then
  default=$(helios-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" ]] || (( $# < 3 )); then
  echo "Usage: helios-agent-account-rename [claude|codex|grok] <account> <name>" >&2
  exit 1
fi

account=$(helios-agent-account-state rename "$@") || exit 1
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: helios agent account use $(jq -r .id <<<"$account")"
# The panel reads account names from the usage record.
helios-agent-usage-update --limits-only "$1" >/dev/null 2>&1 &
