#!/bin/bash

# kestrel:summary=Launch an app or focus an existing window matching a pattern
# kestrel:args=<window-pattern> <launch-command>

if (($# == 0)); then
  echo "Usage: kestrel-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
WINDOW_ID=$(mmsg get all-clients 2>/dev/null | jq -r --arg p "$WINDOW_PATTERN" '.clients[]|select(((.appid // "")|test("\\b" + $p + "\\b";"i")) or ((.title // "")|test("\\b" + $p + "\\b";"i")))|.id' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  mmsg dispatch focusid "client,$WINDOW_ID" >/dev/null 2>&1
else
  eval exec setsid $LAUNCH_COMMAND
fi
