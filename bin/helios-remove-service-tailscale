#!/bin/bash

# helios:summary=Remove Tailscale and its bar plugin.
# helios:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now helios-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
helios-plugin-disable helios.tailscale
helios-webapp-remove "Tailscale" 2>/dev/null || true
helios-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
