#!/bin/bash

# kestrel:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# kestrel:group=remove
# kestrel:name=gaming xbox-controllers
# kestrel:requires-sudo=true

set -e

kestrel-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
