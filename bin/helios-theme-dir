#!/bin/bash

# helios:summary=Print the directory holding a theme, preferring a user-installed copy
# helios:args=<theme-name>
# helios:examples=helios theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: helios-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/helios/themes/$theme ]]; then
  echo "$HOME/.config/helios/themes/$theme"
else
  echo "$HELIOS_PATH/themes/$theme"
fi
