#!/bin/bash

# kestrel:summary=Update the active Kestrel dev checkout

set -euo pipefail

[[ $KESTREL_PATH != "/usr/share/kestrel" ]] || exit 0

if ! git -C "$KESTREL_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: KESTREL_PATH is not a git checkout: $KESTREL_PATH" >&2
  exit 1
fi

upstream=$(git -C "$KESTREL_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Kestrel dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Kestrel dev checkout\e[0m"
git -C "$KESTREL_PATH" pull --ff-only
