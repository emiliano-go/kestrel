#!/bin/bash

# helios:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  helios-brightness-keyboard-mute on
  helios-osd -i microphone-muted -m "Microphone muted"
else
  helios-brightness-keyboard-mute off
  helios-osd -i microphone -m "Microphone on"
fi
