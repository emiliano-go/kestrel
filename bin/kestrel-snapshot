#!/bin/bash

# kestrel:summary=Create or restore system snapshots with snapper
# kestrel:args=<create|restore>
# kestrel:requires-sudo=true

set -e

COMMAND="$1"

if [[ -z $COMMAND ]]; then
  echo "Usage: kestrel-snapshot <create|restore>" >&2
  exit 1
fi

if kestrel-cmd-missing snapper; then
  # The pacman hook must never fail a transaction over a missing snapper.
  [[ $COMMAND == pacman ]] && exit 0
  exit 127 # callers may ignore a deliberately absent snapper
fi

case "$COMMAND" in
pacman)
  # Invoked by the pacman hook after an upgrade (ALPM PostTransaction, already
  # root), so no sudo. Snapper's `cleanup number` trims to the configured
  # NUMBER_LIMIT, so only the most recent snapshots are kept.
  mapfile -t configs < <(snapper --csvout list-configs 2>/dev/null | awk -F, 'NR>1 {print $1}')
  (( ${#configs[@]} > 0 )) || exit 0

  description="pacman $(date '+%Y-%m-%d %H:%M')"
  for config in "${configs[@]}"; do
    snapper -c "$config" create -c number -d "$description" >/dev/null 2>&1 || continue
    snapper -c "$config" cleanup number >/dev/null 2>&1 || true
  done
  ;;
create)
  # The description is just a label, so never let it abort the snapshot.
  DESC="$(kestrel-version 2>/dev/null || echo unknown)"

  # Get existing snapper config names from CSV output
  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')

  # Snapper installed but unconfigured snapshots nothing. Staying quiet here
  # reads as a successful snapshot, so the next update looks recoverable when
  # nothing has ever been captured.
  if (( ${#CONFIGS[@]} == 0 )); then
    echo -e "\e[33mNo Snapper configs found, so no snapshot was created.\e[0m" >&2
    echo "Configure Snapper with: sudo bash -euo pipefail \"$KESTREL_PATH/install/config/snapper.sh\"" >&2
    exit 1
  fi

  echo -e "\e[32mCreate system snapshot\e[0m"

  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number -d "$DESC"
    sudo snapper -c "$config" cleanup number
  done

  echo "Snapshots can be selected during boot."
  ;;
restore)
  sudo limine-snapper-restore
  ;;
esac
