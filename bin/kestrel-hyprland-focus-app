#!/bin/bash

# kestrel:summary=Focus a Mango window by application identity
# kestrel:args=<app-name>
# kestrel:examples=kestrel hyprland focus app Slack

usage() {
  echo "Usage: kestrel-hyprland-focus-app <app-name>" >&2
  exit 1
}

app=${1:-}
[[ -n $app ]] || usage

# Mango exposes the app id as `appid` and the current title as `title` (there is
# no initialClass/initialTitle). Match the app id first, then fall back to the
# title only for agent terminals, whose shared app id is org.kestrel.agent.
id=$(
  mmsg get all-clients 2>/dev/null |
    jq -r --arg pattern "$app" \
      'first(
         (.clients[] | select((.appid // "") | test($pattern; "i"))),
         (.clients[] | select((.appid // "") == "org.kestrel.agent" and ((.title // "") | test($pattern; "i"))))
       ).id // empty'
)

[[ -n $id ]] || exit 1

mmsg dispatch focusid "client,$id" >/dev/null 2>&1
