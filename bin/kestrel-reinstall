#!/bin/bash

# kestrel:summary=Reinstall Kestrel packages and reset default configs
# kestrel:requires-sudo=true

set -e

echo -e "This will reinstall all default Kestrel packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  kestrel-reinstall-pkgs
  kestrel-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && kestrel-system-reboot
fi
