#!/bin/bash

# helios:summary=Launch a floating terminal with the HeliOS presentation wrapper
# helios:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source helios-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="helios-show-logo; $cmd; code=\$?; if (( code != 130 )); then helios-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.helios.terminal --title=HeliOS -e bash -c "$presentation_script"
