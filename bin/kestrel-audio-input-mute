#!/bin/bash

# kestrel:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  kestrel-brightness-keyboard-mute on
  kestrel-osd -i microphone-muted -m "Microphone muted"
else
  kestrel-brightness-keyboard-mute off
  kestrel-osd -i microphone -m "Microphone on"
fi
