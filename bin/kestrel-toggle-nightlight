#!/bin/bash

# kestrel:summary=Toggle nightlight screen temperature
# kestrel:args=[--status]
# kestrel:examples=kestrel toggle nightlight

# Keep in sync with shell/plugins/services/nightlight/Service.qml, which runs the
# same wlsunset command for callers inside the shell.
NIGHT_TEMP=4000
DAY_TEMP=6500

nightlight_enabled() {
  pgrep -x wlsunset >/dev/null
}

status_json() {
  local enabled temperature

  if nightlight_enabled; then
    enabled=true
    temperature=$NIGHT_TEMP
  else
    enabled=false
    temperature=$DAY_TEMP
  fi

  jq -cn --argjson enabled "$enabled" --argjson temperature "$temperature" \
    '{enabled:$enabled, temperature:$temperature}'
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

if nightlight_enabled; then
  pkill -x wlsunset 2>/dev/null || true
else
  setsid wlsunset -t "$NIGHT_TEMP" -T "$DAY_TEMP" >/dev/null 2>&1 &
fi

kestrel-shell -q nightlight refresh
