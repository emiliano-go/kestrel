#!/bin/bash

# helios:summary=Record dictation using Voxtype
# helios:args=<start|stop|toggle>

case "${1:-}" in
  start|toggle) voxtype record "$1" ;;
  stop)
    if helios-cmd-missing voxtype || [[ $(voxtype status) == "stopped" ]]; then
      exit 0
    else
      voxtype record stop
    fi
    ;;
  *) echo "Usage: helios dictation voxtype <start|stop|toggle>" >&2; exit 1 ;;
esac
