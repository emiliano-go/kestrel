#!/bin/bash

# helios:summary=Print the active HeliOS dev-link git branch
# helios:hidden=true

helios_path=${HELIOS_PATH:-/usr/share/helios}
helios_path=${helios_path%/}

[[ $helios_path != "/usr/share/helios" ]] || exit 1

branch=$(git -C "$helios_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$helios_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
