#!/bin/bash

# helios:summary=Print the active HeliOS package channel

set -euo pipefail

# Dev is a linked source checkout: HELIOS_PATH points somewhere other than
# the package-backed install at /usr/share/helios. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $HELIOS_PATH != "/usr/share/helios" ]]; then
  echo dev
  exit 0
fi

# helios-dev / helios-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. helios / helios-settings come
# from either the stable or rc mirror, distinguished by helios-version-channel
# (which reports the mirror as its first token).
if pacman -Q helios-dev helios-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q helios helios-settings >/dev/null 2>&1; then
  channel=$(helios-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
