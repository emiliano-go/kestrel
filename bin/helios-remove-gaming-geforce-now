#!/bin/bash

# helios:summary=Remove the GeForce NOW Flatpak app and its data.
# helios:group=remove
# helios:name=gaming geforce-now

set -e

if helios-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
