#!/bin/bash

# kestrel:summary=Toggle a floating pop-out window for the focused client.
# kestrel:args=[width height x y]

width=${1:-1300}
height=${2:-900}

active=$(mmsg get focusing-client 2>/dev/null) || exit 1
id=$(jq -er '.id' <<<"$active") || exit 1
floating=$(jq -r '.is_floating' <<<"$active")

if [[ $floating == "true" ]]; then
  # Back to tiling.
  mmsg dispatch togglefloating "client,$id" >/dev/null 2>&1 || true
else
  mmsg dispatch togglefloating "client,$id" >/dev/null 2>&1 || true
  mmsg dispatch "resizewin,$width,$height" "client,$id" >/dev/null 2>&1 || true
  mmsg dispatch centerwin "client,$id" >/dev/null 2>&1 || true
fi
