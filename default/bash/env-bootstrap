# Single source of truth for KESTREL_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/kestrel.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-kestrel          (Hyprland session via uwsm)
#   /usr/share/kestrel/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/kestrel.conf is written by kestrel-dev-link and reset by
# kestrel-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/kestrel.conf ]; then
  . /etc/kestrel.conf
  : "${KESTREL_PATH:=/usr/share/kestrel}"
else
  KESTREL_PATH=/usr/share/kestrel
fi
export KESTREL_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/kestrel-* via the kestrel package — prepending
# /usr/share/kestrel/bin would just be noise.
if [ "$KESTREL_PATH" != /usr/share/kestrel ]; then
  case ":$PATH:" in
    *":${KESTREL_PATH%/}/bin:"*) ;;
    *) PATH="${KESTREL_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
kestrel_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
kestrel_wrapper_path=$kestrel_wrapper_dir
if [ -n "${PATH:-}" ]; then
  kestrel_remaining_path=$PATH
  while :; do
    kestrel_path_entry=${kestrel_remaining_path%%:*}
    if [ "$kestrel_path_entry" != "$kestrel_wrapper_dir" ]; then
      kestrel_wrapper_path="$kestrel_wrapper_path:$kestrel_path_entry"
    fi
    case "$kestrel_remaining_path" in
      *:*) kestrel_remaining_path=${kestrel_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$kestrel_wrapper_path
unset kestrel_wrapper_dir kestrel_wrapper_path kestrel_remaining_path kestrel_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
