# Single source of truth for HELIOS_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/helios.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-helios          (Hyprland session via uwsm)
#   /usr/share/helios/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/helios.conf is written by helios-dev-link and reset by
# helios-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/helios.conf ]; then
  . /etc/helios.conf
  : "${HELIOS_PATH:=/usr/share/helios}"
else
  HELIOS_PATH=/usr/share/helios
fi
export HELIOS_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/helios-* via the helios package — prepending
# /usr/share/helios/bin would just be noise.
if [ "$HELIOS_PATH" != /usr/share/helios ]; then
  case ":$PATH:" in
    *":${HELIOS_PATH%/}/bin:"*) ;;
    *) PATH="${HELIOS_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
helios_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
helios_wrapper_path=$helios_wrapper_dir
if [ -n "${PATH:-}" ]; then
  helios_remaining_path=$PATH
  while :; do
    helios_path_entry=${helios_remaining_path%%:*}
    if [ "$helios_path_entry" != "$helios_wrapper_dir" ]; then
      helios_wrapper_path="$helios_wrapper_path:$helios_path_entry"
    fi
    case "$helios_remaining_path" in
      *:*) helios_remaining_path=${helios_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$helios_wrapper_path
unset helios_wrapper_dir helios_wrapper_path helios_remaining_path helios_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
