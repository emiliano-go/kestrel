[Unit]
Description=Notify about pending Kestrel migrations
# Login-only. A directory watcher on /usr/share/kestrel/migrations would fire
# whenever pacman writes that directory, notifying about migrations that are not
# actually pending for this user. Checking once per login is the trigger.
ConditionPathIsDirectory=/usr/share/kestrel/migrations
# The actionable notification launches its terminal through uwsm-app, whose
# daemon starts after graphical-session.target. Run after the target too so this
# oneshot cannot hold the target open while waiting for that daemon.
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kestrel-migrate-notify

[Install]
WantedBy=graphical-session.target
