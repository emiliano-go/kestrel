#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if helios-hw-fingerprint && [[ ! -f /etc/pam.d/helios-lock-fingerprint ]] &&
  helios-done ensure fingerprint-setup-invitation; then
  helios-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec helios-launch-floating-terminal-with-presentation helios-setup-security-fingerprint
fi
