#!/bin/bash

set -e

# HeliOS ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(helios-default-agent) ]] && helios-done ensure agent-setup-invitation; then
  helios-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with HeliOS." \
    --exec helios menu summon setup.default.agent
fi
