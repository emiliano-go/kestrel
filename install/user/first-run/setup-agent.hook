#!/bin/bash

set -e

# On the live ISO the install invitation is the one that matters, so skip the
# agent invitation there.
[[ -e /run/archiso ]] && exit 0

# Kestrel ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(kestrel-default-agent) ]] && kestrel-done ensure agent-setup-invitation; then
  kestrel-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Kestrel." \
    --exec kestrel menu summon setup.default.agent
fi
