# Packages built from source at ISO build time from their git repository,
# instead of the AUR. Format: name=git-url
#
# The repository's local PKGBUILD (packaging/local/PKGBUILD) builds the
# checked-out tree; the result is published to the build-time repository and
# installed into the live rootfs like any other package.
trustsight=https://github.com/emiliano-go/trustsight
linux-kestrel=https://github.com/kestrel-distro/kernel

# Lean desktop builds. Same package names as Arch, with a higher pkgrel, so they
# win over the stock packages in the build-time repository.
hyprland-kestrel=https://github.com/kestrel-distro/hyprland
quickshell-kestrel=https://github.com/kestrel-distro/quickshell
