# Packages built from source at ISO build time from their git repository,
# instead of the AUR. Format: name=git-url
#
# The repository's local PKGBUILD (packaging/local/PKGBUILD) builds the
# checked-out tree; the result is published to the build-time repository and
# installed into the live rootfs like any other package.
trustsight=https://github.com/emiliano-go/trustsight
linux-kestrel=https://github.com/kestrel-distro/kernel

# Lean desktop builds. Distinct package names that conflict with the Arch
# packages, so Arch cannot overwrite them; they are served by the Kestrel
# [kestrel] repository after install.
hyprland-kestrel=https://github.com/kestrel-distro/hyprland
quickshell-kestrel=https://github.com/kestrel-distro/quickshell

# Matched desktop library closure (E2) and the explicit-sync Qt wayland
# plugin (E4), all from kestrel-distro/desktop. Format name=url#subdir: the
# builder looks for the PKGBUILD in the cloned repo at subdir.
hyprutils-kestrel=https://github.com/kestrel-distro/desktop#packaging/hyprutils
hyprlang-kestrel=https://github.com/kestrel-distro/desktop#packaging/hyprlang
hyprgraphics-kestrel=https://github.com/kestrel-distro/desktop#packaging/hyprgraphics
hyprcursor-kestrel=https://github.com/kestrel-distro/desktop#packaging/hyprcursor
hyprwire-kestrel=https://github.com/kestrel-distro/desktop#packaging/hyprwire
aquamarine-kestrel=https://github.com/kestrel-distro/desktop#packaging/aquamarine
qt6-wayland-kestrel=https://github.com/kestrel-distro/desktop#packaging/qt6-wayland
