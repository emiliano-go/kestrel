{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "helios.clock",
    "layout": {
      "left": [
        {
          "id": "helios.menu"
        },
        {
          "id": "helios.workspaces"
        }
      ],
      "center": [
        {
          "id": "helios.indicators"
        },
        {
          "id": "helios.elsewhen"
        },
        {
          "id": "helios.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "helios.keyboard-layout"
        },
        {
          "id": "helios.weather"
        },
        {
          "id": "helios.system-update"
        }
      ],
      "right": [
        {
          "id": "helios.tray"
        },
        {
          "id": "helios.agents"
        },
        {
          "id": "helios.bluetooth"
        },
        {
          "id": "helios.network"
        },
        {
          "id": "helios.audio"
        },
        {
          "id": "helios.monitor"
        },
        {
          "id": "helios.power"
        }
      ]
    }
  },
  "plugins": []
}
