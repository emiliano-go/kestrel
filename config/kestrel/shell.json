{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "kestrel.clock",
    "layout": {
      "left": [
        {
          "id": "kestrel.menu"
        },
        {
          "id": "kestrel.workspaces"
        }
      ],
      "center": [
        {
          "id": "kestrel.indicators"
        },
        {
          "id": "kestrel.elsewhen"
        },
        {
          "id": "kestrel.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "kestrel.keyboard-layout"
        },
        {
          "id": "kestrel.weather"
        }
      ],
      "right": [
        {
          "id": "kestrel.tray"
        },
        {
          "id": "kestrel.agents"
        },
        {
          "id": "kestrel.bluetooth"
        },
        {
          "id": "kestrel.network"
        },
        {
          "id": "kestrel.audio"
        },
        {
          "id": "kestrel.monitor"
        },
        {
          "id": "kestrel.power"
        }
      ]
    }
  },
  "plugins": []
}
